{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdview",
  "version": "1.2.4",
  "identifier": "dev.zburgers.mdview",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "mdview",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob: http: https:; font-src 'self' data:; connect-src 'none'; media-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["appimage", "deb", "rpm", "nsis", "dmg", "app"],
    "publisher": "Zburgers",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "ext": ["txt", "text"],
        "name": "Plain Text Document",
        "description": "Plain text document",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ],
    "shortDescription": "Tiny local Markdown reader",
    "longDescription": "A tiny, fast, local-first Markdown reader with split source mode, Mermaid support, and print-friendly output.",
    "copyright": "Copyright 2026 Zburgers",
    "license": "MIT",
    "homepage": "https://github.com/Zburgers/mdview",
    "icon": [
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "files": {
          "usr/share/metainfo/mdview.appdata.xml": "packaging/linux/mdview.appdata.xml"
        }
      },
      "deb": {
        "depends": [],
        "desktopTemplate": "packaging/linux/mdview.desktop.hbs",
        "files": {
          "usr/share/metainfo/mdview.appdata.xml": "packaging/linux/mdview.appdata.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "packaging/linux/mdview.desktop.hbs",
        "files": {
          "/usr/share/metainfo/mdview.appdata.xml": "packaging/linux/mdview.appdata.xml"
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDRjMxMDIyNzk5MjY1QTQKUldTa1paSjVJaER6ZkpVNVl0a0xkRkdSdGc4ZVVGZjZjSzdIS3BURzJ1NXc1Wk1iZzFFcythMXMK",
      "endpoints": [
        "https://github.com/Zburgers/mdview/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
